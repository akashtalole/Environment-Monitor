{
  "name": "environment-monitor",
  "version": "0.1.0",
  "description": "Monitor Indian environmental approvals (EC, EIA, FC, CRZ, wildlife, PCB consents) across PARIVESH, legacy MoEFCC portals, MPCB and CPCB. Starts with Maharashtra pumped storage projects.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "envmon": "src/cli.js"
  },
  "scripts": {
    "monitor": "node src/cli.js run",
    "track": "node src/cli.js track",
    "probe": "node src/cli.js probe",
    "list": "node src/cli.js list",
    "serve": "node src/server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "undici": "^7.0.0"
  },
  "optionalDependencies": {
    "playwright": "^1.50.0"
  }
}
