{
  "_readme": "Each source maps to a connector in src/connectors. Set enabled:false to skip one. TLS is always verified; if a *.nic.in server omits its intermediate certificate, save that intermediate as PEM under certs/ and set \"caFile\": \"certs/<file>.pem\" on the source (see README).",
  "sources": [
    {
      "id": "parivesh-track",
      "name": "PARIVESH – Track Your Proposal",
      "connector": "parivesh-track",
      "enabled": true,
      "url": "https://parivesh.nic.in/newupgrade/#/trackYourProposal",
      "refreshHours": 12,
      "options": {
        "navigationTimeoutMs": 90000,
        "resultTimeoutMs": 45000,
        "searchInputSelectors": [
          "input[formcontrolname*='proposal' i]",
          "input[placeholder*='Proposal' i]",
          "input[placeholder*='Single Window' i]",
          "input[placeholder*='Keyword' i]",
          "input[placeholder*='Search' i]",
          "input[type='search']",
          "input[type='text']"
        ],
        "searchButtonText": "Search"
      }
    },
    {
