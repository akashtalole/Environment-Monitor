  "guidelines": {
    "_readme": "WGEEP section 13 'Proposed guidelines/summary recommendations for sector-wise activities' (Table 6, PDF pages 61–67). Text abridged, wording kept. These are recommendations; the Government of India did not adopt the WGEEP regime.",
    "energy": {
      "page": 65,
      "ESZ1": "Allow run of the river schemes with maximum height of 3 m serving local needs, subject to gram sabha consent. No forest clearance or stream diversion for new projects. New small hydropower projects (10 MW and below) permissible. No new thermal power plants. No large scale wind power projects.",
      "ESZ2": "No new dams above 15 m or new thermal plants. New hydro projects between 10–25 MW (up to 10 m height) permissible. Run-of-the-river hydropower only after a cumulative impact study of the river basin.",
      "ESZ3": "Large power plants allowed subject to strict environmental regulations including cumulative impact assessment, carrying capacity studies, minimum forest clearance and assessment of flows required downstream, including the ecological needs of the river.",
      "all": "No diversion of streams/rivers allowed for any power projects."
    },
    "mining": {
      "page": 64,
      "ESZ1": "No new licenses to be given for mining. Where mining exists, it should be phased out in 5 years, by 2016.",
      "ESZ2": "No new licenses to be given for mining. This moratorium can be reviewed on a case by case basis. Existing mining under strict regulation and social audit.",
      "ESZ3": "New mining only for scarce minerals not available on the plains, under strict regulation and social audit, subject to free prior informed consent of tribal and other communities."
    },
    "industry": {
      "page": 65,
      "ESZ1": "No new polluting (red and orange category) industries.",
      "ESZ2": "No new polluting (red and orange category) industries.",
      "ESZ3": "New industries may be set up under strict regulation and social audit."
    },
    "transport": {
      "page": 66,
      "ESZ1": "No new railway lines and major roads, except where highly essential, subject to EIA, strict regulation and social audit. Avoidance of new highways, expressways.",
      "ESZ2": "No new railway lines and major roads, except when highly essential and subject to EIA, strict regulation and social audit.",
      "ESZ3": "Essential new roads/railways may be allowed subject to strict regulation and social audit."
    }
  },
  "passages": [
    {
      "id": "water-tower",
      "title": "Water tower of the peninsula",
      "text": "The hill chain of the Western Ghats, a treasure trove of biodiversity and the water tower of [peninsular India]… Krishna, Godavari and Kaveri, the three major rivers of the Southern Peninsula…",
      "source": "wgeep",
      "page": 28,
      "verified": true,
      "theme": "hydrology"
    },
    {
      "id": "endemism",
      "title": "Endemic species",
      "text": "The Western Ghats harbours well over two thousand endemic species of flowering plants, fish, frogs…",
      "source": "wgeep",
      "page": 37,
      "verified": true,
      "theme": "biodiversity"
    },
    {
      "id": "bhimashankar",
      "title": "Bhimashankar Wildlife Sanctuary",
      "text": "The northward extension of this evergreen forest belt constitutes the Bhimashankar Wildlife Sanctuary, an ancient, extensive Sacred Grove on the hill from which the Bhima river, another major tributary of the Krishna, originates. No action whatsoever has been taken since 2002 to establish an ESA around this PA…",
      "source": "wgeep",
      "page": 59,
      "verified": true,
      "theme": "biodiversity",
      "relevance": "The EIA reports of Malshej Ghat Bhorande, Saidongar-2 and Shirawta PSPs each name Bhimashankar WLS as the nearest protected area (10.8–19.7 km)."
    },
    {
      "id": "krishna-koyna",
      "title": "Origin of the Krishna and Koyna",
      "text": "…the region also has a rich natural heritage, and is the origin of the Krishna and Koyna rivers. The region faces a severe threat from booming tourism…",
      "source": "wgeep",
      "page": 51,
      "verified": true,
      "theme": "hydrology"
    }
  ]
}
