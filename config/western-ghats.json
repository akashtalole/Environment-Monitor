  "timeline": [
    {
      "date": "2010",
      "event": "MoEF constitutes the Western Ghats Ecology Expert Panel (WGEEP) chaired by Madhav Gadgil.",
      "source": "hlwgSecondary",
      "verified": "secondary"
    },
    {
      "date": "2011-08-31",
      "event": "WGEEP submits its report. It zones the Western Ghats into Ecologically Sensitive Zones 1, 2 and 3 at taluka level and proposes a Western Ghats Ecology Authority.",
      "source": "wgeep",
      "page": 3,
      "verified": true
    },
    {
      "date": "2013",
      "event": "High Level Working Group (Kasturirangan) report: about 37% of the Western Ghats proposed as Ecologically Sensitive Area, down from about 64% under WGEEP.",
      "source": "hlwgSecondary",
      "verified": "secondary"
    },
    {
      "date": "2014–2024",
      "event": "MoEFCC issues a series of draft notifications declaring villages in six states as the Western Ghats Ecologically Sensitive Area. Dates, areas and the Maharashtra village list are not yet loaded from a primary source.",
      "source": null,
      "verified": "unconfirmed"
    }
  ],
